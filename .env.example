# Copy to `.env` (git-ignored) and fill in. The server loads `.env` on startup.

# REQUIRED for authentication — a long random string, unique per install.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, the server generates one on first boot and persists it to
# ./.session-secret (git-ignored). Set it explicitly for a multi-node or
# containerised deploy so every instance signs sessions with the same key.
SESSION_SECRET="replace-with-a-long-random-secret"

# Base URL this server is reached at. Used for self-referential links.
APP_URL="http://localhost:3000"

# --- Optional integrations. Leave blank to disable; the app runs fine without. -

# AI assistant (Google Gemini). Blank => the assistant returns a
# "not configured" notice; nothing else changes.
GEMINI_API_KEY=""

# Exclusivi complaint webhook. Blank => POST /api/complaints/ingest returns 503.
# Set a shared secret to enable it; the caller sends it as the x-exclusivi-key header.
EXCLUSIVI_API_KEY=""
EXCLUSIVI_BASE_URL="https://api.okgini.com"
EXCLUSIVI_SESSION_TOKEN=""
